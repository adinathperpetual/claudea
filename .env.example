# ===================================================================
#  Client Master Sync — configuration
#  Copy to .env (git-ignored) and fill in. NEVER commit the real .env.
# ===================================================================

# ---- Finesse login (required) --------------------------------------
FINESSE_USER_ID=
FINESSE_PASSWORD=
# The PAN that Finesse asks for on its login page
FINESSE_PAN=

FINESSE_BASE_URL=https://app.perpetualinv.com/finesse
# Login page, if different from the base URL
FINESSE_LOGIN_URL=

# ---- How to fetch the client list ----------------------------------
# auto = export -> api -> playwright (first one configured that works)
FINESSE_FETCH_METHOD=auto

# 1) Report export (CSV/Excel) URL, if Finesse has one (relative to base URL is fine)
FINESSE_EXPORT_URL=

# 2) Internal JSON endpoint the client-list page calls (find it with:
#    python -m finesse_sync discover)
FINESSE_API_URL=
FINESSE_API_METHOD=GET
# Dotted path to the list in the JSON, e.g. data.items (blank = auto-detect)
FINESSE_API_RECORDS_PATH=
FINESSE_API_PAGE_PARAM=page
FINESSE_API_SIZE_PARAM=pageSize
FINESSE_API_PAGE_SIZE=500
FINESSE_API_FIRST_PAGE=1
# Optional pure-HTTP login endpoint. Blank = log in with a real browser
# (Playwright) and reuse its cookies for the export/API calls.
FINESSE_LOGIN_API_URL=
FINESSE_LOGIN_API_FIELDS=userId,password,pan
FINESSE_LOGIN_API_FORMAT=json

# 3) Browser automation fallback
#    Either the direct URL of the client list page...
FINESSE_CLIENT_LIST_URL=
#    ...or the menu to click through after login
FINESSE_MENU_PATH=Masters > Client Master
FINESSE_HEADLESS=true
# Use an installed Chrome instead of Playwright's Chromium (optional), e.g.
# C:\Program Files\Google\Chrome\Application\chrome.exe
FINESSE_BROWSER_PATH=

# Only if auto-detection misses (CSS selectors / exact column names)
FINESSE_SEL_USER=
FINESSE_SEL_PASSWORD=
FINESSE_SEL_PAN=
FINESSE_SEL_SUBMIT=
FINESSE_SEL_LOGGED_IN=
FINESSE_SEL_TABLE=
FINESSE_SEL_NEXT_PAGE=
FINESSE_FIELD_NAME=
FINESSE_FIELD_PAN=
# Finesse client code column (e.g. clientCode -> PCA00141)
FINESSE_FIELD_TRADING_CODE=
# Broker trading account column. Blank = read it from "Client Name (D062580)"
FINESSE_FIELD_TRADING_ACCOUNT=

# ---- Network ---------------------------------------------------------
FINESSE_TIMEOUT_SECONDS=60
# Attempts on network failure (backoff 2s, 4s, 8s, 16s…)
FINESSE_RETRIES=4
# Re-login after this long even if the session still seems valid
FINESSE_SESSION_MAX_AGE_MINUTES=240

# ---- Sync safety & schedule -----------------------------------------
# Abort without changes if Finesse returns fewer clients than this
SYNC_MIN_RECORDS=1
# Abort if more than this % of active clients would be flagged missing
SYNC_MAX_MISSING_PERCENT=30
SYNC_SCHEDULE_ENABLED=true
# cron: minute hour day month weekday  (daily 08:00)
SYNC_SCHEDULE_CRON=0 8 * * *
SYNC_TIMEZONE=Asia/Kolkata

# ---- Storage & access --------------------------------------------------
# Encrypts PANs, exceptional passwords and the saved Finesse session.
# Generate: python -m finesse_sync genkey   — back it up; without it the data is unreadable.
CNE_ENCRYPTION_KEY=
# Comma-separated. Generate each with: python -m finesse_sync gentoken
# Admin tokens: Client Master screen, sync, edits.
CNE_ADMIN_TOKENS=
# Extractor tokens: password lookup only (for every user's browser).
CNE_EXTRACTOR_TOKENS=
# Where the SQLite DB lives (default ./data)
CNE_DATA_DIR=
# Full path of the SQLite file (default <CNE_DATA_DIR>/client_master.db)
CNE_DB_PATH=
# Browser origins allowed to call the service ("null" = index.html opened as a file)
CNE_CORS_ORIGINS=null,http://127.0.0.1:8765,http://localhost:8765
